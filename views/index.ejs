<%- include("partials/header.ejs") %>

<h1>Check a crypto price</h1>
<p class="lead">Choose a market (for example <strong>BTC-USD</strong>) to see its latest price.</p>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<!-- Form sends the chosen market to /price?symbol=... -->
<form action="/price" method="GET" class="card">
  <label for="symbol">Market</label>
  <select id="symbol" name="symbol" required>
    <% groups.forEach((g) => { %>
      <optgroup label="Priced in <%= g.quote %>">
        <% g.symbols.forEach((s) => { %>
          <option value="<%= s %>" <%= s === 'BTC-USD' ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </optgroup>
    <% }) %>
  </select>
  <button type="submit">Get price</button>
</form>

<% if (movers.length) { %>
  <h2>Active markets (traded in the last 24h)</h2>
  <table>
    <thead>
      <tr><th>Market</th><th>Last price</th><th>24h change</th></tr>
    </thead>
    <tbody>
      <% movers.forEach((m) => { %>
        <tr>
          <td><a href="/price?symbol=<%= m.symbol %>"><%= m.symbol %></a></td>
          <td><%= m.last_trade_price.toLocaleString("en-US", { maximumFractionDigits: 8 }) %></td>
          <td class="<%= m.change >= 0 ? 'up' : 'down' %>"><%= m.change === null ? '—' : (m.change > 0 ? '+' : '') + m.change.toFixed(2) + '%' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include("partials/footer.ejs") %>
